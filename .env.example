NODE_ENV=development
SERVICE_NAME=equato-scheduler
LOG_LEVEL=debug
PORT=4100
# Loopback on a developer machine (like Postgres/Redis in compose): not reachable
# from the network. Containers use the built-in default 0.0.0.0.
HOST=127.0.0.1
# The scheduler's HTTP port serves only health probes. Bind it to the private
# network in production; it is never exposed publicly.
TRUST_PROXY=false

# SAME database as equato-api and equato-webhooks, as the same least-privilege
# application role (SECURITY.md §19). Only pool size / timeout differ.
DATABASE_URL=postgresql://equato_app:equato_app_dev_password@localhost:55432/equato
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Shared Redis; queues live under REDIS_KEY_PREFIX:queue:.
REDIS_URL=redis://:equato_redis_dev_password@localhost:56379
REDIS_KEY_PREFIX=equato

# How many jobs one worker runs at once. Keep at or below DATABASE_POOL_MAX so
# a burst of jobs cannot exhaust the connection pool (enforced at boot).
WORKER_CONCURRENCY=5

# Menu scan AI (the key lives ONLY here — never in the API or any frontend).
# mock = deterministic and offline; production must use a real provider.
SCAN_AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
SCAN_AI_MODEL=claude-opus-5
SCAN_AI_TIMEOUT_MS=180000

# Object storage — the same buckets equato-api uses (media variants, scan images).
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=equato
S3_SECRET_ACCESS_KEY=equato_dev_password
S3_BUCKET_MEDIA=equato-media
S3_BUCKET_SCANS=equato-scans
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:59000/equato-media
